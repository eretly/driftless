[Unit]
Description=Driftless VPS Gateway (Zero-Drop QUIC Reverse Tunnel)
Documentation=https://github.com/ERETLY/driftless
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=driftless
Group=driftless
ExecStartPre=/usr/bin/install -d -o driftless -g driftless -m 0700 /etc/driftless/certs
EnvironmentFile=-/etc/driftless/gateway.env
ExecStart=/usr/local/bin/driftless server   -quic 0.0.0.0:4242   -token-file /etc/driftless/token   -ports 8080:80,8096:8096   -direct :8888   -cert-dir /etc/driftless/certs
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/driftless/certs

[Install]
WantedBy=multi-user.target
